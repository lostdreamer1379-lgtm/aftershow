# AFTERSHOW — Environment Configuration
# Copy the relevant values into frontend/.env and backend/.env

# ── Frontend (frontend/.env) ───────────────────
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Backend (backend/.env) ─────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://user:password@host:5432/aftershow?schema=public
DIRECT_URL=postgresql://user:password@host:5432/aftershow?schema=public

SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# Note: The documented VidRift public embed integration does not require
# a private API key or account — no VidRift credential is needed here.
